{
  "scripts": {
    "serve": "esbuild assets/scripts/main.ts --bundle --outfile=dist/main.js --format=iife --target=es2018 --watch",
    "build": "tsc --noEmit && esbuild assets/scripts/main.ts --bundle --minify --outfile=dist/main.js --format=iife --target=es2018",
    "test": "node --test tests/frontend.cjs",
    "test:php": "node --test tests/php.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "terser": "^5.44.0",
    "typescript": "^5.6.3"
  }
}
